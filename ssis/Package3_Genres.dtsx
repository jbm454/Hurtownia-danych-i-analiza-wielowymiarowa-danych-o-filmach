          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="DELETE FROM bridge_movie_genre;&#xA;DELETE FROM dim_genre;&#xA;&#xA;DBCC CHECKIDENT ('dim_genre', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\176774 Ładowanie bridge_movie_genre"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DE8FDA0E-354C-494F-A486-1CDF0347207E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 Ładowanie bridge_movie_genre"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{984FB82B-4DDC-49A1-9A40-1207477AD112}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="INSERT INTO bridge_movie_genre (movie_id, genre_id)&#xA;SELECT DISTINCT&#xA;    dm.movie_id,&#xA;    dg.genre_id&#xA;FROM staging_movies sm&#xA;JOIN dim_movie dm&#xA;    ON sm.id = dm.source_id&#xA;CROSS APPLY STRING_SPLIT(sm.genres, ',') AS split_genre&#xA;JOIN dim_genre dg&#xA;    ON LTRIM(RTRIM(split_genre.value)) = dg.genre_name&#xA;WHERE sm.genres IS NOT NULL&#xA;  AND LTRIM(RTRIM(split_genre.value)) &lt;&gt; ''&#xA;  AND LTRIM(RTRIM(split_genre.value)) &lt;&gt; 'NA';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\176774 Ładowanie dim_genre"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B46326C7-1B56-4663-A366-F1BE960891A0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 Ładowanie dim_genre"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{984FB82B-4DDC-49A1-9A40-1207477AD112}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="INSERT INTO dim_genre (genre_name)&#xA;SELECT DISTINCT&#xA;    LTRIM(RTRIM(value)) AS genre_name&#xA;FROM staging_movies&#xA;CROSS APPLY STRING_SPLIT(genres, ',')&#xA;WHERE genres IS NOT NULL&#xA;  AND LTRIM(RTRIM(value)) &lt;&gt; ''&#xA;  AND LTRIM(RTRIM(value)) &lt;&gt; 'NA';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
