    <DTS:Executable
      DTS:refId="Package\176774 Ładowanie dim_date"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D0D6A170-2A7F-4E53-B78E-2ADEE0BA0FFB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 Ładowanie dim_date"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32D0AD9E-EE7A-4170-BBD6-E57AC9F4DA86}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="INSERT INTO dim_date (full_date, year, month, day, quarter)&#xA;SELECT DISTINCT&#xA;    release_date AS full_date,&#xA;    YEAR(release_date) AS year,&#xA;    MONTH(release_date) AS month,&#xA;    DAY(release_date) AS day,&#xA;    DATEPART(QUARTER, release_date) AS quarter&#xA;FROM staging_movies&#xA;WHERE release_date IS NOT NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\176774 Ładowanie dim_language"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0F83688B-EFC6-4776-A5A4-5519C57360F6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 Ładowanie dim_language"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32D0AD9E-EE7A-4170-BBD6-E57AC9F4DA86}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="INSERT INTO dim_language (language_code)&#xA;SELECT DISTINCT&#xA;    LTRIM(RTRIM(original_language)) AS language_code&#xA;FROM staging_movies&#xA;WHERE original_language IS NOT NULL&#xA;  AND LTRIM(RTRIM(original_language)) &lt;&gt; '';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\176774 Ładowanie dim_movie"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{777F19C2-7295-4C5A-A9A4-25D4CA732B2D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 Ładowanie dim_movie"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32D0AD9E-EE7A-4170-BBD6-E57AC9F4DA86}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="WITH movies_unique AS (&#xA;    SELECT&#xA;        id AS source_id,&#xA;        title,&#xA;        original_title,&#xA;        runtime,&#xA;        overview,&#xA;        tagline,&#xA;        ROW_NUMBER() OVER (&#xA;            PARTITION BY id&#xA;            ORDER BY release_date DESC, title&#xA;        ) AS rn&#xA;    FROM staging_movies&#xA;)&#xA;INSERT INTO dim_movie (&#xA;    source_id,&#xA;    title,&#xA;    original_title,&#xA;    runtime,&#xA;    overview,&#xA;    tagline&#xA;)&#xA;SELECT&#xA;    source_id,&#xA;    title,&#xA;    original_title,&#xA;    runtime,&#xA;    overview,&#xA;    tagline&#xA;FROM movies_unique&#xA;WHERE rn = 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\176774 Ładowanie dim_status"
