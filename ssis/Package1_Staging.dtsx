      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{32D0AD9E-EE7A-4170-BBD6-E57AC9F4DA86}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="INSERT INTO dim_status (status_name)&#xA;SELECT DISTINCT&#xA;    LTRIM(RTRIM(status)) AS status_name&#xA;FROM staging_movies&#xA;WHERE status IS NOT NULL&#xA;  AND LTRIM(RTRIM(status)) &lt;&gt; '';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
