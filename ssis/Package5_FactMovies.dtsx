    <DTS:Executable
      DTS:refId="Package\176774 Ładowanie fact_movies"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A382A398-AC17-45E0-BBDD-33B4E8CBFB2F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 Ładowanie fact_movies"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{963988A8-58EB-43D4-8702-E5DFF98740DB}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="WITH movies_unique AS (&#xA;    SELECT&#xA;        *,&#xA;        ROW_NUMBER() OVER (&#xA;            PARTITION BY id&#xA;            ORDER BY release_date DESC, title&#xA;        ) AS rn&#xA;    FROM staging_movies&#xA;)&#xA;INSERT INTO fact_movies (&#xA;    movie_id,&#xA;    date_id,&#xA;    language_id,&#xA;    status_id,&#xA;    budget,&#xA;    revenue,&#xA;    vote_average,&#xA;    vote_count,&#xA;    popularity&#xA;)&#xA;SELECT&#xA;    dm.movie_id,&#xA;    dd.date_id,&#xA;    dl.language_id,&#xA;    ds.status_id,&#xA;    sm.budget,&#xA;    sm.revenue,&#xA;    sm.vote_average,&#xA;    sm.vote_count,&#xA;    sm.popularity&#xA;FROM movies_unique sm&#xA;JOIN dim_movie dm&#xA;    ON sm.id = dm.source_id&#xA;JOIN dim_date dd&#xA;    ON sm.release_date = dd.full_date&#xA;JOIN dim_language dl&#xA;    ON LTRIM(RTRIM(sm.original_language)) = dl.language_code&#xA;JOIN dim_status ds&#xA;    ON LTRIM(RTRIM(sm.status)) = ds.status_name&#xA;WHERE sm.rn = 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
