  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\176774 Czyszczenie tabel KPI"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FC1EA808-8D2B-4DA7-AEAD-48C0D82F2B73}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 Czyszczenie tabel KPI"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F3AF407C-EC08-4400-BE96-6A92D149AA24}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="DROP TABLE IF EXISTS kpi_movies_by_year;&#xA;DROP TABLE IF EXISTS kpi_finance_by_year;&#xA;DROP TABLE IF EXISTS kpi_movies_by_genre;&#xA;DROP TABLE IF EXISTS kpi_movies_by_country;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\176774 KPI 1 Filmy według roku"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A81DF58A-3CD7-4C3C-A055-BFDC306C3A35}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 KPI 1 Filmy według roku"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F3AF407C-EC08-4400-BE96-6A92D149AA24}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="SELECT&#xA;    dd.year,&#xA;    COUNT(*) AS liczba_filmow,&#xA;    COUNT(CASE WHEN fm.vote_count &gt; 0 THEN 1 END) AS liczba_ocenionych_filmow,&#xA;    AVG(CASE &#xA;            WHEN fm.vote_count &gt; 0 THEN fm.vote_average &#xA;        END) AS srednia_ocena,&#xA;    AVG(fm.popularity) AS srednia_popularnosc&#xA;INTO kpi_movies_by_year&#xA;FROM fact_movies fm&#xA;JOIN dim_date dd&#xA;    ON fm.date_id = dd.date_id&#xA;JOIN dim_status ds&#xA;    ON fm.status_id = ds.status_id&#xA;WHERE ds.status_name = 'Released'&#xA;  AND dd.year BETWEEN 1980 AND 2025&#xA;GROUP BY dd.year;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\176774 KPI 2 Finanse według roku"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{48BF25A2-D001-4F16-A57A-0A58DF75AB4A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 KPI 2 Finanse według roku"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F3AF407C-EC08-4400-BE96-6A92D149AA24}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="SELECT&#xA;    dd.year,&#xA;    COUNT(*) AS liczba_filmow,&#xA;    SUM(fm.budget) AS suma_budzetu,&#xA;    SUM(fm.revenue) AS suma_przychodu,&#xA;    SUM(fm.profit) AS suma_zysku,&#xA;    AVG(fm.profit) AS sredni_zysk&#xA;INTO kpi_finance_by_year&#xA;FROM fact_movies fm&#xA;JOIN dim_date dd&#xA;    ON fm.date_id = dd.date_id&#xA;JOIN dim_status ds&#xA;    ON fm.status_id = ds.status_id&#xA;WHERE ds.status_name = 'Released'&#xA;  AND dd.year BETWEEN 1888 AND 2025&#xA;  AND fm.budget IS NOT NULL&#xA;  AND fm.revenue IS NOT NULL&#xA;GROUP BY dd.year;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\176774 KPI 3 Filmy według gatunku"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{21EC027B-E5B6-4C00-9B9E-C90C95FB501F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 KPI 3 Filmy według gatunku"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F3AF407C-EC08-4400-BE96-6A92D149AA24}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="SELECT&#xA;    dg.genre_name,&#xA;    COUNT(*) AS liczba_filmow,&#xA;    COUNT(CASE WHEN fm.vote_count &gt; 0 THEN 1 END) AS liczba_ocenionych_filmow,&#xA;    AVG(CASE &#xA;            WHEN fm.vote_count &gt; 0 THEN fm.vote_average &#xA;        END) AS srednia_ocena,&#xA;    AVG(fm.popularity) AS srednia_popularnosc,&#xA;    SUM(CASE WHEN fm.revenue IS NOT NULL THEN 1 ELSE 0 END) AS filmy_z_przychodem&#xA;INTO kpi_movies_by_genre&#xA;FROM fact_movies fm&#xA;JOIN dim_status ds&#xA;    ON fm.status_id = ds.status_id&#xA;JOIN bridge_movie_genre bmg&#xA;    ON fm.movie_id = bmg.movie_id&#xA;JOIN dim_genre dg&#xA;    ON bmg.genre_id = dg.genre_id&#xA;WHERE ds.status_name = 'Released'&#xA;GROUP BY dg.genre_name;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\176774 KPI 4 Filmy według kraju"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6120DF94-B844-4DA0-83D6-9832BDBC96C0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 KPI 4 Filmy według kraju"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F3AF407C-EC08-4400-BE96-6A92D149AA24}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="SELECT&#xA;    dc.country_name,&#xA;    COUNT(*) AS liczba_filmow,&#xA;    COUNT(CASE WHEN fm.vote_count &gt; 0 THEN 1 END) AS liczba_ocenionych_filmow,&#xA;    AVG(CASE &#xA;            WHEN fm.vote_count &gt; 0 THEN fm.vote_average &#xA;        END) AS srednia_ocena,&#xA;    AVG(fm.popularity) AS srednia_popularnosc,&#xA;    SUM(fm.revenue) AS suma_przychodu&#xA;INTO kpi_movies_by_country&#xA;FROM fact_movies fm&#xA;JOIN dim_status ds&#xA;    ON fm.status_id = ds.status_id&#xA;JOIN bridge_movie_country bmc&#xA;    ON fm.movie_id = bmc.movie_id&#xA;JOIN dim_country dc&#xA;    ON bmc.country_id = dc.country_id&#xA;WHERE ds.status_name = 'Released'&#xA;GROUP BY dc.country_name;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
