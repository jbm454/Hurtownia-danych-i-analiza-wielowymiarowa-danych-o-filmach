    <DTS:Executable
      DTS:refId="Package\176774 Przygotowanie krajów do Lookup"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{376E3046-8ADE-42C5-AF68-79B0763001E2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 Przygotowanie krajów do Lookup"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CB19429E-7349-4AEE-9D36-651F3065F5DE}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="DELETE FROM bridge_movie_country;&#xA;DELETE FROM dim_country;&#xA;&#xA;DBCC CHECKIDENT ('dim_country', RESEED, 0);&#xA;&#xA;DROP TABLE IF EXISTS stg_movie_country;&#xA;DROP TABLE IF EXISTS country_dirty_test;&#xA;DROP TABLE IF EXISTS country_lookup_match;&#xA;DROP TABLE IF EXISTS country_lookup_no_match;&#xA;DROP TABLE IF EXISTS country_fuzzy_matches;&#xA;&#xA;CREATE TABLE stg_movie_country (&#xA;    movie_id INT,&#xA;    source_id INT,&#xA;    country_name NVARCHAR(200)&#xA;);&#xA;&#xA;CREATE TABLE country_dirty_test (&#xA;    movie_id INT,&#xA;    source_id INT,&#xA;    country_name NVARCHAR(200)&#xA;);&#xA;&#xA;CREATE TABLE country_lookup_match (&#xA;    movie_id INT,&#xA;    country_id INT,&#xA;    country_name NVARCHAR(200)&#xA;);&#xA;&#xA;CREATE TABLE country_lookup_no_match (&#xA;    movie_id INT,&#xA;    source_id INT,&#xA;    country_name NVARCHAR(200)&#xA;);&#xA;&#xA;CREATE TABLE country_fuzzy_matches (&#xA;    movie_id INT,&#xA;    source_id INT,&#xA;    dirty_country_name NVARCHAR(200),&#xA;    matched_country_id INT,&#xA;    matched_country_name NVARCHAR(200),&#xA;    similarity FLOAT,&#xA;    confidence FLOAT&#xA;);&#xA;&#xA;;WITH sample_movies AS (&#xA;    SELECT TOP (5000)&#xA;        id,&#xA;        production_countries&#xA;    FROM staging_movies&#xA;    WHERE production_countries IS NOT NULL&#xA;      AND LTRIM(RTRIM(production_countries)) &lt;&gt; ''&#xA;      AND LTRIM(RTRIM(production_countries)) &lt;&gt; 'NA'&#xA;      AND LTRIM(RTRIM(production_countries)) &lt;&gt; 'Unknown'&#xA;    ORDER BY id&#xA;)&#xA;INSERT INTO stg_movie_country (&#xA;    movie_id,&#xA;    source_id,&#xA;    country_name&#xA;)&#xA;SELECT DISTINCT&#xA;    dm.movie_id,&#xA;    sm.id AS source_id,&#xA;    LTRIM(RTRIM(split_country.value)) AS country_name&#xA;FROM sample_movies sm&#xA;JOIN dim_movie dm&#xA;    ON sm.id = dm.source_id&#xA;CROSS APPLY STRING_SPLIT(sm.production_countries, ',') AS split_country&#xA;WHERE LTRIM(RTRIM(split_country.value)) &lt;&gt; ''&#xA;  AND LTRIM(RTRIM(split_country.value)) &lt;&gt; 'NA'&#xA;  AND LTRIM(RTRIM(split_country.value)) &lt;&gt; 'Unknown';&#xA;&#xA;INSERT INTO dim_country (country_name)&#xA;SELECT DISTINCT country_name&#xA;FROM stg_movie_country&#xA;WHERE country_name IS NOT NULL&#xA;  AND LTRIM(RTRIM(country_name)) &lt;&gt; ''&#xA;&#xA;UNION&#xA;&#xA;SELECT 'United States of America'&#xA;&#xA;UNION&#xA;&#xA;SELECT 'United Kingdom'&#xA;&#xA;UNION&#xA;&#xA;SELECT 'South Korea'&#xA;&#xA;UNION&#xA;&#xA;SELECT 'Canada';&#xA;&#xA;INSERT INTO country_dirty_test (&#xA;    movie_id,&#xA;    source_id,&#xA;    country_name&#xA;)&#xA;SELECT&#xA;    movie_id,&#xA;    source_id,&#xA;    country_name&#xA;FROM stg_movie_country;&#xA;&#xA;INSERT INTO country_dirty_test (&#xA;    movie_id,&#xA;    source_id,&#xA;    country_name&#xA;)&#xA;SELECT TOP 20&#xA;    movie_id,&#xA;    source_id,&#xA;    'United Stats of America'&#xA;FROM stg_movie_country&#xA;WHERE country_name = 'United States of America';&#xA;&#xA;INSERT INTO country_dirty_test (&#xA;    movie_id,&#xA;    source_id,&#xA;    country_name&#xA;)&#xA;SELECT TOP 20&#xA;    movie_id,&#xA;    source_id,&#xA;    'United Kingdm'&#xA;FROM stg_movie_country&#xA;WHERE country_name = 'United Kingdom';&#xA;&#xA;INSERT INTO country_dirty_test (&#xA;    movie_id,&#xA;    source_id,&#xA;    country_name&#xA;)&#xA;SELECT TOP 20&#xA;    movie_id,&#xA;    source_id,&#xA;    'Soth Korea'&#xA;FROM stg_movie_country&#xA;WHERE country_name = 'South Korea';&#xA;&#xA;INSERT INTO country_dirty_test (&#xA;    movie_id,&#xA;    source_id,&#xA;    country_name&#xA;)&#xA;SELECT TOP 20&#xA;    movie_id,&#xA;    source_id,&#xA;    'Canda'&#xA;FROM stg_movie_country&#xA;WHERE country_name = 'Canada';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\176774 Ładowanie bridge_movie_country"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3714BA4C-A16B-4D56-B719-81D62531C380}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="176774 Ładowanie bridge_movie_country"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CB19429E-7349-4AEE-9D36-651F3065F5DE}"
          SQLTask:BypassPrepare="False"
          SQLTask:SqlStatementSource="INSERT INTO bridge_movie_country (movie_id, country_id)&#xA;SELECT DISTINCT&#xA;    movie_id,&#xA;    country_id&#xA;FROM country_lookup_match&#xA;WHERE movie_id IS NOT NULL&#xA;  AND country_id IS NOT NULL&#xA;&#xA;UNION&#xA;&#xA;SELECT DISTINCT&#xA;    movie_id,&#xA;    matched_country_id AS country_id&#xA;FROM country_fuzzy_matches&#xA;WHERE movie_id IS NOT NULL&#xA;  AND matched_country_id IS NOT NULL&#xA;  AND similarity &gt;= 0.20;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
