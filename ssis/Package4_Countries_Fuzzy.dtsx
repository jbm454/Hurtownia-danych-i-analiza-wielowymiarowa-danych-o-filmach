                  name="MaxMemoryUsage" />
                <property
                  dataType="System.Null"
                  description="Specifies the name of the fuzzy-match index table to be reused or the table name in which a newly generated fuzzy-match index table will be written."
                  name="MatchIndexName"
                  state="escaped" />
