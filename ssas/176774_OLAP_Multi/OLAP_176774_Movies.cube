  <Source dwd:design-time-name="368cc14a-e174-45ec-b9c4-ef261039591e">
    <DataSourceViewID>Imdb</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="5165adf5-16fb-4290-a19f-1742b358f043">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].[Średnia ocena]
 AS [Measures].[Vote Average] / [Measures].[Fact Movies Count], 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Średni przychód na film]
 AS IIF(
    [Measures].[Fact Movies Count] = 0,
    NULL,
    [Measures].[Revenue] / [Measures].[Fact Movies Count]
), 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Rentowność]
 AS IIF(
    [Measures].[Budget] = 0,
    NULL,
    [Measures].[Profit] / [Measures].[Budget]
), 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="951541ca-aa06-4250-b255-1b4269d11813">
      <ID>KPI</ID>
      <Name>KPI_Przychody_vs_Budzet</Name>
      <Value>[Measures].[Revenue]</Value>
      <Goal>[Measures].[Budget]</Goal>
      <Status>CASE
    WHEN [Measures].[Revenue] &gt;= [Measures].[Budget] THEN 1
    WHEN [Measures].[Revenue] &gt;= [Measures].[Budget] * 0.75 THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN [Measures].[Profit] &gt; 0 THEN 1
    WHEN [Measures].[Profit] = 0 THEN 0
    ELSE -1
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="5a49c35b-3f54-401f-be75-5f9c632398f9">
      <ID>KPI 1</ID>
      <Name>KPI_Zysk_Filmow</Name>
      <Value>[Measures].[Profit]</Value>
      <Goal>0</Goal>
      <Status>CASE
    WHEN [Measures].[Profit] &gt; 0 THEN 1
    WHEN [Measures].[Profit] = 0 THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN [Measures].[Profit] &gt; 0 THEN 1
    WHEN [Measures].[Profit] = 0 THEN 0
    ELSE -1
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="03f78cd9-2aa1-469e-9aed-fe26d3b5eec4">
      <ID>KPI 2</ID>
      <Name>KPI_Rentownosc</Name>
      <Value>[Measures].[Rentownosc]</Value>
      <Goal>1</Goal>
      <Status>CASE
    WHEN [Measures].[Rentownosc] &gt;= 1 THEN 1
    WHEN [Measures].[Rentownosc] &gt;= 0 THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN [Measures].[Rentownosc] &gt;= 1 THEN 1
    WHEN [Measures].[Rentownosc] &gt;= 0 THEN 0
    ELSE -1
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="470e6eac-03c9-4e04-83bf-91309c0c0e97">
      <ID>KPI 3</ID>
      <Name>KPI_Sredni_Przychod_Na_Film</Name>
      <Value>[Measures].[Sredni Przychod Na Film]</Value>
      <Goal>1000000</Goal>
      <Status>CASE
    WHEN [Measures].[Sredni Przychod Na Film] &gt;= 1000000 THEN 1
    WHEN [Measures].[Sredni Przychod Na Film] &gt;= 500000 THEN 0
    ELSE -1
END</Status>
      <Trend>CASE
    WHEN [Measures].[Sredni Przychod Na Film] &gt;= 1000000 THEN 1
    WHEN [Measures].[Sredni Przychod Na Film] &gt;= 500000 THEN 0
    ELSE -1
END</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>